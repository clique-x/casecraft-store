# Production settings for infra/prod/docker-compose.yml. setup-vps.sh copies this to .env and fills the
# secrets with random values. Never commit .env.

# Public domains. Their DNS A records (hPanel → Domains → gadgetshub.io → DNS) must point at the VPS:
# @, www and api.
SITE_DOMAIN=gadgetshub.io
API_DOMAIN=api.gadgetshub.io

# The storefront's public address. Product images are served from here and Medusa calls its /api/revalidate.
STOREFRONT_URL=https://gadgetshub.io

# CORS: the storefront's origin(s), and the admin's (the API domain itself). Comma-separated, no spaces.
STORE_CORS=https://gadgetshub.io,https://www.gadgetshub.io
ADMIN_CORS=https://api.gadgetshub.io
AUTH_CORS=https://api.gadgetshub.io,https://gadgetshub.io,https://www.gadgetshub.io

# Generated by setup-vps.sh (openssl rand -hex 32). Hex only, so they are safe inside URLs.
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
# Shared by Medusa and the storefront so admin edits refresh the store's cached pages.
STOREFRONT_REVALIDATE_SECRET=

MEDUSA_DISABLE_TELEMETRY=true

# Written by first-run.sh after the seed. The storefront is built and started once these are set.
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=

# Razorpay: leave empty for Cash on Delivery only. Webhook URL: https://<API_DOMAIN>/hooks/payment/razorpay_razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phone login (Twilio Verify): off while TWILIO_VERIFY_SERVICE_SID is empty.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
