# Production settings for infra/prod/docker-compose.yml. setup-vps.sh copies this to .env and fills the
# secrets with random values. Never commit .env.

# The API's public domain, e.g. api.yourstore.in. Its DNS A record must point at the VPS.
# No domain yet? api.<VPS-IP-with-dashes>.sslip.io works (e.g. api.203-0-113-7.sslip.io).
API_DOMAIN=api.example.com

# Where the storefront runs. Product images are served from here and Medusa calls its /api/revalidate.
STOREFRONT_URL=https://casecraft-store.vercel.app

# CORS: the storefront's origin(s), and the admin's (the API domain itself). Comma-separated, no spaces.
STORE_CORS=https://casecraft-store.vercel.app
ADMIN_CORS=https://api.example.com
AUTH_CORS=https://api.example.com,https://casecraft-store.vercel.app

# Generated by setup-vps.sh (openssl rand -hex 32). Hex only, so they are safe inside URLs.
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
# Must equal REVALIDATE_SECRET in the storefront's Vercel environment.
STOREFRONT_REVALIDATE_SECRET=

MEDUSA_DISABLE_TELEMETRY=true

# Razorpay: leave empty for Cash on Delivery only. Webhook URL: https://<API_DOMAIN>/hooks/payment/razorpay_razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phone login (Twilio Verify): off while TWILIO_VERIFY_SERVICE_SID is empty.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
