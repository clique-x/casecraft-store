# Production settings for infra/prod/docker-compose.yml. setup-vps.sh copies this to .env and fills the
# secrets with random values. Never commit .env.

# Public domains. Their DNS A records (hPanel → Domains → gadgetshub.io → DNS) must point at the VPS:
# @, www and api.
SITE_DOMAIN=gadgetshub.io
API_DOMAIN=api.gadgetshub.io

# The storefront's public address. Product images are served from here and Medusa calls its /api/revalidate.
STOREFRONT_URL=https://gadgetshub.io

# CORS: the storefront's origin(s), and the admin's (the API domain itself). Comma-separated, no spaces.
STORE_CORS=https://gadgetshub.io,https://www.gadgetshub.io
ADMIN_CORS=https://api.gadgetshub.io
AUTH_CORS=https://api.gadgetshub.io,https://gadgetshub.io,https://www.gadgetshub.io

# Generated by setup-vps.sh (openssl rand -hex 32). Hex only, so they are safe inside URLs.
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
# Shared by Medusa and the storefront so admin edits refresh the store's cached pages.
STOREFRONT_REVALIDATE_SECRET=

MEDUSA_DISABLE_TELEMETRY=true

# caddy (default) serves 80/443 itself; nginx when the server already runs nginx (use-host-nginx.sh sets it).
PROXY=caddy
# Loopback ports for a host nginx and for the storefront build.
STOREFRONT_HOST_PORT=3100
MEDUSA_HOST_PORT=9100

# Written by first-run.sh after the seed. The storefront is built and started once these are set.
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=

# Razorpay: leave empty for Cash on Delivery only. Webhook URL: https://<API_DOMAIN>/hooks/payment/razorpay_razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phone login (Twilio Verify): off while TWILIO_VERIFY_SERVICE_SID is empty.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Email: sign-in codes for My orders, order confirmations, "on its way" emails and the admin's password reset.
# Off, with email sign-in hidden on the store, while SMTP_HOST is empty. Any SMTP mailbox works, e.g. Hostinger
# email (hPanel → Emails): SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, SMTP_USER = the full mailbox address,
# SMTP_PASSWORD = its password in single quotes. EMAIL_FROM must use that same mailbox.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# e.g. GadgetsHub <orders@gadgetshub.io>
EMAIL_FROM=
# Where customers' replies go (optional), e.g. support@gadgetshub.io
EMAIL_REPLY_TO=

# New-order alerts for the shop's owner. Comma-separated; leave a line out for the default, set it empty to
# turn that alert off. The email goes out as soon as the email lines above are filled.
ORDER_ALERT_EMAILS=shambhvi91@gmail.com
ORDER_ALERT_WHATSAPP=+918077402898
# WhatsApp alerts go through Twilio (TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN above): off while
# TWILIO_WHATSAPP_FROM is empty. Set it to your WhatsApp sender's number (e.g. +14155238886) and
# TWILIO_WHATSAPP_ORDER_TEMPLATE_SID to the approved template's Content SID (HX…). See apps/backend/README.md.
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_ORDER_TEMPLATE_SID=
