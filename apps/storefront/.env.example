# Copy to .env.local. Leave the three MEDUSA_ values empty to run on the built-in sample catalogue.
# `pnpm --filter backend seed` prints the values for a local backend.

MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=

# Shared with the backend's STOREFRONT_REVALIDATE_SECRET; lets Medusa refresh the cached catalogue.
REVALIDATE_SECRET=change-me
