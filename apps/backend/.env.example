# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/casecraft
# Optional locally. Required in production so the server and worker share events and locks.
REDIS_URL=redis://localhost:6379

# Generate real values for production, e.g. `openssl rand -hex 32`.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# The storefront (Next.js dev server) and the admin dashboard.
STORE_CORS=http://localhost:3000,http://localhost:3011
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:3000

# Where Medusa tells the storefront to refresh its cached catalogue after an admin change.
STOREFRONT_URL=http://localhost:3000
# Must match REVALIDATE_SECRET in apps/storefront/.env.local.
STOREFRONT_REVALIDATE_SECRET=change-me

# Set to `true` to stop Medusa sending anonymous usage data.
MEDUSA_DISABLE_TELEMETRY=true

# Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_ keys until launch.
# Leave empty to offer Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL https://<api-domain>/hooks/payment/razorpay_razorpay,
# events payment.authorized, payment.captured, payment.failed, order.paid.
RAZORPAY_WEBHOOK_SECRET=

# Phone login (Twilio Verify). Without the Service SID the feature stays hidden.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
